# =============================================================================
# DuoPact — Variáveis de Ambiente (Railway PostgreSQL com Schema Apartado)
# =============================================================================

# URL do banco PostgreSQL existente no Railway
# Se vazio no ambiente local, o projeto usa SQLite local (.data/dualpact.sqlite)
DATABASE_URL="postgresql://postgres:SENHA@HOST.railway.app:PORT/railway"

# Nome do schema exclusivo no PostgreSQL (padrão: dualpact)
# Todas as tabelas do projeto ficam isoladas dentro de dualpact.*
DB_SCHEMA="dualpact"

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET="dualpact-secret-key-change-in-production"
