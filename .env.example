# =============================================================================
# DuoPact — Variáveis de Ambiente (Railway PostgreSQL com Schema Apartado)
# =============================================================================

# URL do banco PostgreSQL existente no Railway
# Se vazio no ambiente local, o projeto usa SQLite local (.data/dualpact.sqlite)
DATABASE_URL="postgresql://postgres:SENHA@HOST.railway.app:PORT/railway"

# Nome do schema exclusivo no PostgreSQL (padrão: dualpact)
# Todas as tabelas do projeto ficam isoladas dentro de dualpact.*
DB_SCHEMA="dualpact"

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET="dualpact-secret-key-change-in-production"

# Chave do Gemini para análise automática do contexto de gastos das faturas
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"

# Bot do Telegram para avisos diários de vencimento (@BotFather)
TELEGRAM_BOT_TOKEN=""
# Opcional: username sem @ (se vazio, o sistema descobre via getMe do Telegram)
TELEGRAM_BOT_USERNAME=""
# Opcional: segredo do webhook do Telegram (se vazio, derivado automaticamente)
TELEGRAM_WEBHOOK_SECRET=""

# Segredo usado pelo Vercel Cron Job (enviado em Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# URL pública da aplicação para links nos avisos (ex.: https://vue-base-bice.vercel.app)
APP_BASE_URL=""
